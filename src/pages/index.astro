---
import { Icon } from 'astro-icon/components'
import BaseLayout from '@/layouts/BaseLayout.astro'
import BioData from '@/components/BioData.astro'
import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.astro'
import ScrollToTop from '@/components/ScrollToTop.astro'
import SongCard from '@/components/SongCard.astro'
import SongCarousel from '@/components/SongCarousel.astro'
import { coverSongs, originalSongs, songUrl } from '@/lib/songs'
import {
  AVATAR_IMAGE,
  AVATAR_IMAGE_LARGE,
  DISCORD_URL,
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_TITLE,
  SITE_URL,
  SOCIALS,
  TAGLINE,
} from '@/lib/site'

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE_NAME,
  alternateName: 'Rizuka',
  description: SITE_DESCRIPTION,
  url: SITE_URL,
  image: AVATAR_IMAGE_LARGE,
  jobTitle: 'Virtual YouTuber',
  nationality: { '@type': 'Country', name: 'Indonesia' },
  birthDate: '--08-13',
  sameAs: SOCIALS.map((social) => social.url),
}

const songListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Lagu Original ${SITE_NAME}`,
  numberOfItems: originalSongs.length,
  itemListElement: originalSongs.map((song, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: songUrl(song.slug, SITE_URL),
    name: song.title,
  })),
}

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: SITE_URL,
  inLanguage: 'id-ID',
  description: SITE_DESCRIPTION,
}

/**
 * The newest original song leads the grid as a full-width feature, and the
 * rest follow. Five songs map to exactly five cells, so the grid never
 * renders an empty tile as the catalogue grows.
 */
const [featuredSong, ...restSongs] = [...originalSongs].reverse()

/** Cover songs already arrive newest-first, so the head leads the bento. */
const [featuredCover, ...restCovers] = coverSongs
---

<BaseLayout
  title={SITE_TITLE}
  canonicalPath="/"
  jsonLd={[personSchema, songListSchema, websiteSchema]}
  preloadImage={AVATAR_IMAGE}
>
  <Header isHome />

  <main id="main" class="flex-1">
    <!--
      Hero: asymmetric 7/5 split. The moon-cat identity is carried by the
      night-sky background rather than by emoji in the headline.
    -->
    <section
      id="top"
      class="relative isolate overflow-hidden bg-ink px-4 pb-20 pt-24 text-white lg:px-6 lg:pb-28"
    >
      <div class="moonlight pointer-events-none absolute inset-0 -z-10"></div>
      <div class="starfield pointer-events-none absolute inset-0 -z-10"></div>

      <div class="mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-7">
          <p
            class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.2em] text-white/60"
            data-reveal
          >
            <Icon name="ph:moon-stars-fill" class="h-4 w-4 text-primary-100" />
            Indie VTuber Indonesia
          </p>

          <h1 class="mt-6" data-reveal style="--reveal-delay:90ms">
            <span class="block text-lg font-semibold tracking-tight text-white/70 sm:text-xl">
              {SITE_NAME}
            </span>
            <span
              class="mt-2 block max-w-[16ch] text-4xl font-extrabold leading-[1.05] tracking-tight
                sm:text-5xl lg:text-6xl"
            >
              {TAGLINE}
            </span>
          </h1>

          <p
            class="mt-6 max-w-md text-base leading-relaxed text-white/70 sm:text-lg"
            data-reveal
            style="--reveal-delay:180ms"
          >
            Kucing bulan yang bernyanyi, bercerita, dan menemani malammu bersama Rizuniverse.
          </p>

          <div class="mt-9 flex flex-wrap gap-3" data-reveal style="--reveal-delay:260ms">
            <a href="#original" class="btn btn-onbrand">
              <Icon name="ph:play-fill" class="h-4 w-4" />
              Dengar Lagu Original
            </a>
            <a href={DISCORD_URL} class="btn btn-ghost-onbrand">Join Rizuniverse</a>
          </div>
        </div>

        <div class="lg:col-span-5" data-reveal style="--reveal-delay:200ms">
          {/* Offset frame: the glow sits behind and slightly off-axis so the
              video reads as lit by the moon rather than pasted onto a panel. */}
          <div class="relative">
            <div
              class="absolute -inset-6 -z-10 rounded-[2rem] bg-primary/25 blur-3xl"
              aria-hidden="true"
            >
            </div>
            <div class="overflow-hidden rounded-2xl border border-white/20 shadow-2xl shadow-black/40">
              <video
                controls
                muted
                playsinline
                preload="none"
                poster={AVATAR_IMAGE}
                class="aspect-video w-full bg-black object-cover"
              >
                <source src="/videos/intro.mp4" type="video/mp4" />
                Browser kamu tidak mendukung pemutaran video.
              </video>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- About: editorial layout, avatar overlapping the section edge -->
    <section id="about" class="scroll-mt-24 bg-ink pb-20 lg:pb-28">
      <BioData />
    </section>

    <!--
      Original songs. Bento with a featured lead cell: five songs occupy
      exactly five cells, so no tile is ever left blank.
    -->
    <section id="original" class="scroll-mt-24 bg-background py-20 lg:py-28">
      <div class="mx-auto max-w-7xl px-4 lg:px-6">
        <header class="mb-12 max-w-2xl" data-reveal>
          <h2 class="text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">
            Original Song
          </h2>
          <p class="mt-3 text-muted-foreground">
            {originalSongs.length} lagu original dengan lirik lengkap di halamannya masing-masing.
          </p>
        </header>

        <div class="md:hidden">
          <SongCarousel count={originalSongs.length} label="Original Song">
            {
              originalSongs.map((song) => (
                <li class="w-[82vw] shrink-0 snap-center">
                  <SongCard song={song} slug={song.slug} />
                </li>
              ))
            }
          </SongCarousel>
        </div>

        <div class="hidden gap-6 md:grid md:grid-cols-2 lg:grid-cols-4">
          <SongCard song={featuredSong} slug={featuredSong.slug} featured />
          {
            restSongs.map((song, index) => (
              <SongCard song={song} slug={song.slug} delay={(index + 1) * 70} />
            ))
          }
        </div>
      </div>
    </section>

    <!--
      Cover songs. Same bento as the originals — newest as the lead cell —
      on a tinted surface, at three columns so six followers fill two rows.
    -->
    <section id="cover" class="scroll-mt-24 bg-secondary py-20 lg:py-28">
      <div class="mx-auto max-w-7xl px-4 lg:px-6">
        <header class="mb-12 max-w-2xl" data-reveal>
          <h2 class="text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">
            Cover Song
          </h2>
          <p class="mt-3 text-muted-foreground">
            Lagu yang dibawakan ulang {SITE_NAME}, sendiri maupun bersama teman.
          </p>
        </header>

        <div class="md:hidden">
          <SongCarousel count={coverSongs.length} label="Cover Song">
            {
              coverSongs.map((song) => (
                <li class="w-[82vw] shrink-0 snap-center">
                  <SongCard song={song} />
                </li>
              ))
            }
          </SongCarousel>
        </div>

        <div class="hidden gap-6 md:grid md:grid-cols-2 lg:grid-cols-3">
          <SongCard song={featuredCover} featured />
          {restCovers.map((song, index) => <SongCard song={song} delay={(index + 1) * 70} />)}
        </div>
      </div>
    </section>
  </main>

  <ScrollToTop />
  <Footer />
</BaseLayout>
