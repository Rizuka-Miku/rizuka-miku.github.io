---
import { Icon } from 'astro-icon/components'
import ThemeToggle from '@/components/ThemeToggle'
import { DISCORD_URL, SITE_NAME } from '@/lib/site'

interface Props {
  /** Anchor links only work on the homepage; elsewhere they are prefixed with "/". */
  isHome?: boolean
}

const { isHome = false } = Astro.props
const prefix = isHome ? '' : '/'

/** Slugs and labels are unchanged: existing anchors and analytics still resolve. */
const navLinks = [
  { label: 'About', href: `${prefix}#about` },
  { label: 'Original Song', href: `${prefix}#original` },
  { label: 'Cover Song', href: `${prefix}#cover` },
]
---

<header class="fixed inset-x-0 top-0 z-50 px-3 pt-3 lg:px-6 lg:pt-4">
  {/*
    A floating capsule rather than a full-bleed bar: it keeps the header at
    64px, lets the hero art run underneath it, and reads as one object.
  */}
  <div
    class="mx-auto flex h-16 max-w-7xl items-center gap-4 rounded-full border border-white/15
      bg-ink/70 px-3 text-white shadow-lg shadow-black/10 backdrop-blur-xl
      supports-[backdrop-filter]:bg-ink/55 sm:px-5"
  >
    <a
      href={isHome ? '#top' : '/'}
      class="flex shrink-0 items-center gap-2.5 rounded-full transition-transform duration-300 hover:scale-[1.03]"
      aria-label={`${SITE_NAME}, beranda`}
    >
      <img
        src="/rizuka-bocil.png"
        width="40"
        height="40"
        class="h-10 w-10 rounded-full ring-2 ring-white/25"
        alt=""
      />
      <span class="hidden text-sm font-bold tracking-tight sm:inline">{SITE_NAME}</span>
    </a>

    <nav class="ml-auto hidden items-center gap-7 md:flex" aria-label="Navigasi utama">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="nav-link text-sm font-medium text-white/85 transition-colors hover:text-white"
          >
            {link.label}
          </a>
        ))
      }

      <a
        href={DISCORD_URL}
        class="btn btn-onbrand !px-5 !py-2 text-[13px]"
      >
        Join Rizuniverse
      </a>

      <ThemeToggle client:idle />
    </nav>

    <div class="ml-auto flex items-center gap-1 md:hidden">
      <ThemeToggle client:idle />
      <button
        type="button"
        id="menu-button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Buka menu navigasi"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full transition-colors hover:bg-white/15"
      >
        <Icon name="ph:list-bold" class="h-5 w-5" aria-hidden="true" />
      </button>
    </div>
  </div>

  {/*
    Rendered in the HTML and hidden with `hidden` so the links exist for
    crawlers; JS only toggles visibility.
  */}
  <nav
    id="mobile-menu"
    hidden
    aria-label="Navigasi seluler"
    class="mx-auto mt-2 max-w-7xl overflow-hidden rounded-3xl border border-white/15 bg-ink/90
      text-white shadow-xl shadow-black/20 backdrop-blur-xl md:hidden"
  >
    <ul class="space-y-1 p-3">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="block rounded-full px-4 py-2.5 text-sm font-medium transition-colors hover:bg-white/15"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="pt-1">
        <a href={DISCORD_URL} class="btn btn-onbrand w-full !py-2.5">Join Rizuniverse</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const button = document.getElementById('menu-button')
  const menu = document.getElementById('mobile-menu')

  if (button && menu) {
    const setOpen = (open: boolean) => {
      menu.hidden = !open
      button.setAttribute('aria-expanded', String(open))
      button.setAttribute('aria-label', open ? 'Tutup menu navigasi' : 'Buka menu navigasi')
    }

    button.addEventListener('click', () => {
      setOpen(menu.hidden !== false)
    })

    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false)
    })

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) {
        setOpen(false)
        button.focus()
      }
    })
  }
</script>
