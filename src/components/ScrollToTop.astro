---
import { Icon } from 'astro-icon/components'
/** Progressive enhancement: hidden until JS observes a scroll past the fold. */
---

{/*
  A zero-height sentinel one viewport down, positioned against the document
  rather than a parent. IntersectionObserver reports when it leaves the top of
  the screen, which replaces a per-frame scroll listener.
*/}
<div
  id="scroll-sentinel"
  aria-hidden="true"
  class="pointer-events-none absolute left-0 top-[100dvh] h-px w-px"
>
</div>

<button
  type="button"
  id="scroll-to-top"
  hidden
  aria-label="Kembali ke atas"
  class="btn btn-solid fixed bottom-6 right-6 z-50 h-12 w-12 !p-0 opacity-0 shadow-lg
    shadow-primary/30 transition-all duration-300 hover:scale-110 data-[visible]:opacity-100"
>
  <Icon name="ph:arrow-up-bold" class="h-5 w-5" aria-hidden="true" />
</button>

<script>
  const button = document.getElementById('scroll-to-top')
  const sentinel = document.getElementById('scroll-sentinel')

  if (button && sentinel && 'IntersectionObserver' in window) {
    button.hidden = false
    button.style.pointerEvents = 'none'

    // The button appears once the sentinel has scrolled off the top, so the
    // work happens on intersection changes rather than on every scroll frame.
    const observer = new IntersectionObserver(
      ([entry]) => {
        const past = entry.boundingClientRect.top < 0
        button.toggleAttribute('data-visible', past)
        button.style.pointerEvents = past ? 'auto' : 'none'
      },
      { threshold: 0 },
    )

    observer.observe(sentinel)

    button.addEventListener('click', () => {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' })
    })
  }
</script>
