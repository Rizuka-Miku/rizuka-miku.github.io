---
import SocialIcon from '@/components/SocialIcon.astro'
import { DISCORD_URL, SITE_NAME, SOCIALS, TAGLINE } from '@/lib/site'

const year = new Date().getFullYear()
---

{/*
  The footer closes the page on the same night surface the hero opened with,
  so the theme reads as one continuous world rather than flipping to a pale
  slab at the bottom.
*/}
<footer class="relative isolate overflow-hidden bg-ink text-white">
  <div class="moonlight pointer-events-none absolute inset-0 -z-10 opacity-70"></div>

  <div class="mx-auto max-w-7xl px-4 py-16 lg:px-6 lg:py-20">
    <div class="flex flex-col gap-10 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-2xl font-extrabold tracking-tight sm:text-3xl">{SITE_NAME}</p>
        <p class="mt-2 max-w-sm text-white/60">{TAGLINE}</p>
      </div>

      <a href={DISCORD_URL} class="btn btn-onbrand w-fit">Join Rizuniverse</a>
    </div>

    <ul class="mt-12 flex flex-wrap gap-2.5">
      {
        SOCIALS.map((social) => (
          <li>
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${SITE_NAME} di ${social.name}`}
              class="inline-flex h-11 w-11 items-center justify-center rounded-full border
                border-white/15 bg-white/5 text-white/70 transition-all duration-300
                hover:-translate-y-0.5 hover:border-white/40 hover:bg-white/10 hover:text-white"
            >
              <SocialIcon icon={social.icon} />
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-12 border-t border-white/10 pt-6 text-sm text-white/45">
      &copy; {year} {SITE_NAME}.
    </p>
  </div>
</footer>
